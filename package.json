{
  "name": "cookbook",
  "version": "1.0.0",
  "description": "Share and manage recipes. Built with Express, Mongoose and EJS.",
  "homepage": "https://github.com/Robhan92/cookbook#readme",
  "bugs": {
    "url": "https://github.com/Robhan92/cookbook/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Robhan92/cookbook.git"
  },
  "license": "MIT",
  "author": "Robin",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "css": "npx @tailwindcss/cli -i ./src/input.css -o ./src/public/css/output.css --watch",
    "eslint": "npx eslint . || exit 0",
    "eslint:fix": "npx eslint . --fix || exit 0",
    "stylelint": "npx stylelint src/input.css || exit 0",
    "stylelint:fix": "npx stylelint src/input.css --fix || exit 0",
    "lint": "npm run eslint && npm run stylelint"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "http-errors": "^2.0.1",
    "mongoose": "^9.9.4",
    "morgan": "^1.12.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "nodemon": "^3.1.14",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0"
  }
}
